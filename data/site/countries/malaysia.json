malaysia_3.webp","link":"https://goo.gl/maps/wiqZWRZzjy62wm2y7"}],"sidewalks":[{"image":"geohints/sidewalks/sidewalk_10.webp","link":"https://goo.gl/maps/GcYFzwYB8URLq3kN7"}],"traffic_lights":[{"image":"geohints/trafficLights/light_17.webp","link":"https://goo.gl/maps/qFTx4adLGUCC9Ppv6"}],"utility_poles":[{"image":"geohints/utilityPoles/pole_9.webp","link":"https://goo.gl/maps/qYyn6MrjFd66gvxr9"},{"image":"geohints/utilityPoles/pole_142.webp","link":"https://goo.gl/maps/X4xENxNdBuuyXMkN9"},{"image":"geohints/utilityPoles/pole_143.webp","link":"https://goo.gl/maps/k4Dz4nHJkGrPb6NJ6"},{"image":"geohints/utilityPoles/pole_248.webp","link":"https://maps.app.goo.gl/jQieU39bxysSA3oR9"}]},"key":"malaysia"}