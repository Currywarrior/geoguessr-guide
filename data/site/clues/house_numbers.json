ource_page":"/meta/houseNumbers"},{"country":"bosnia and herzegovina","country_name":"Bosnia and Herzegovina","image":"geohints/houseNumbers/hn_27.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/hn_27.png","link":"https://maps.app.goo.gl/7aE5gzL2L9dqPpdW7","source_page":"/meta/houseNumbers"},{"country":"bosnia and herzegovina","country_name":"Bosnia and Herzegovina","image":"geohints/houseNumbers/hn_29.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/hn_29.png","link":"https://maps.app.goo.gl/ohmqgw8wrzkZVmrK7","source_page":"/meta/houseNumbers"},{"country":"croatia","country_name":"Croatia","image":"geohints/houseNumbers/croatia.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/croatia.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"czechia","country_name":"Czech Republic","image":"geohints/houseNumbers/czech_republic_1.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/czech_republic_1.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"czechia","country_name":"Czech Republic","image":"geohints/houseNumbers/czech_republic_2.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/czech_republic_2.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"france","country_name":"France","image":"geohints/houseNumbers/france.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/france.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"georgia","country_name":"Georgia","image":"geohints/houseNumbers/hn_32.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/hn_32.png","link":"https://maps.app.goo.gl/qtVbmHtgu4VCrEL5A","source_page":"/meta/houseNumbers"},{"country":"georgia","country_name":"Georgia","image":"geohints/houseNumbers/hn_33.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/hn_33.png","link":"https://maps.app.goo.gl/8NEj3fW4ULRVWyyC8","source_page":"/meta/houseNumbers"},{"country":"georgia","country_name":"Georgia","image":"geohints/houseNumbers/hn_34.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/hn_34.png","link":"https://maps.app.goo.gl/kdDrL2nuXFzFnMtU7","source_page":"/meta/houseNumbers"},{"country":"greece","country_name":"Greece","image":"geohints/houseNumbers/greece.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/greece.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"latvia","country_name":"Latvia","image":"geohints/houseNumbers/latvia.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/latvia.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"netherlands","country_name":"Netherlands","image":"geohints/houseNumbers/netherlands.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/netherlands.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"slovakia","country_name":"Slovakia","image":"geohints/houseNumbers/slovakia.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/slovakia.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"slovenia","country_name":"Slovenia","image":"geohints/houseNumbers/slovenia.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/slovenia.jpg","link":"","source_page":"/meta/houseNumbers"},{"country":"slovenia","country_name":"Slovenia","image":"geohints/houseNumbers/slovenia_2.webp","src":"https://ocsc00skc0wokcs8kw8g8k84.geohints.com/storage/houseNumbers/slovenia_2.jpg","link":"https://maps.app.goo.gl/VwV4bAhjwvDf1W4g7","source_page":"/meta/houseNumbers"}],"tips":[{"id":"rdKk","text":["House numbers in France are most commonly blue, typically written in a serif font with slightly exaggerated shapes. This is most useful when differentiating from Italy, which almost never uses blue house number signs.","NOTE: Similar designs can be found in all other neighbouring, as well as many other, countries."],"text_zh":[],"image":"plonkit/france/1_housenumber.webp","link":"https://maps.app.goo.gl/LyW7w21VXLXNNYo59","clues":["architecture","house_numbers","signs"],"important":false,"tagged":true,"country":"france","country_name":"France"},{"id":"ZA6H","text":["House numbers in Czechia are generally written on **blue** or **red signs** with thin white borders.","NOTE: On the contrary, Slovak house numbers are typically written on [**white signs**](https://goo.gl/maps/arqzJku5JuJJ3CcQ8)** **with a thin red or black border."],"text_zh":[],"image":"plonkit/czechia/cz_housenumbers.webp","link":"https://goo.gl/maps/WRhpwkmvNyJWiyov5","clues":["house_numbers","architecture","signs"],"important":false,"tagged":false,"country":"czechia","country_name":"Czechia"},{"id":"EtCV","text":["Pairs of black and white house numbers are found in Brno.","NOTE: The city district can be found written on the black house number."],"text_zh":[],"image":"plonkit/czechia/cz_brnohousenumber.webp","link":"https://goo.gl/maps/rsFGAEHRknpovhbe8","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"czechia","country_name":"Czechia"},{"id":"NidB","text":["Pilsen house numbers typically consist of two red and white octagonal plates with inverse colour schemes."],"text_zh":[],"image":"plonkit/czechia/cz_pilsenhousenumber.webp","link":"https://goo.gl/maps/2B44bo1WnoATx35u9","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"czechia","country_name":"Czechia"},{"id":"dfwx","text":["House numbers in České Budějovice have one red and one white plate with **underlined numbers**."],"text_zh":[],"image":"plonkit/czechia/cz_ceskebudejovicehousenumber.webp","link":"https://goo.gl/maps/rQFdttJdn7XFH6Lz8","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"czechia","country_name":"Czechia"},{"id":"1Tsw","text":["Red house numbers with a **dividing line** and a **Roman numeral** are unique to Liberec.","The dividing line is an important identifying factor, as Roman numerals can be found on house numbers in [other cities.](https://goo.gl/maps/dS4PNxQdieaMEBxm9)"],"text_zh":[],"image":"plonkit/czechia/cz_liberechousenumber.webp","link":"https://goo.gl/maps/q4VeetmYq8XwpQpF9","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"czechia","country_name":"Czechia"},{"id":"37rL","text":["Písek uses **yellow house numbers** with a black outline."],"text_zh":[],"image":"plonkit/czechia/cz_pisekhousenumber.webp","link":"https://goo.gl/maps/kZghvjpNsFL3vQ9G8","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"czechia","country_name":"Czechia"},{"id":"VLAz","text":["It is fairly common to find **oval-shaped** blue house numbers in Estonia.","NOTE: This is not common in the other Baltic countries, but can also be found in [Russia](https://www.google.com/maps/@59.0913517,28.1667574,3a,15y,304.49h,91.94t/data=!3m7!1e1!3m5!1sTX_XXjOnF4tmR0_rySvAQQ!2e0!5s20130601T000000!7i13312!8i6656?entry=ttu)."],"text_zh":[],"image":"plonkit/estonia/ee_housenumber.webp","link":"https://goo.gl/maps/kYEp7By8e1LjQK4x6","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"estonia","country_name":"Estonia"},{"id":"0SY5","text":["Blue house numbers with the number written with [Arabic numerals](https://en.wikipedia.org/wiki/Arabic_numerals) in the top left and with [Eastern Arabic numerals](https://en.wikipedia.org/wiki/Eastern_Arabic_numerals) in the bottom right, with a thin **diagonal line** between them, can be found in Bethlehem. [Street signs](https://goo.gl/maps/eouNa6SnvDgD8WQr9) will generally have the same format."],"text_zh":[],"image":"plonkit/israel-west-bank/ps_betlehemhousenumber.webp","link":"https://goo.gl/maps/8DW1NTcm7GbR5BQdA","clues":["house_numbers","architecture","language","signs"],"important":false,"tagged":false,"country":"israel and the west bank","country_name":"Israel & the West Bank"},{"id":"wUDq","text":["House numbers in Rosh Haayin are blue, with a **G-clef** in the bottom left corner."],"text_zh":[],"image":"plonkit/israel-west-bank/il_roshhaayinhousenumber.webp","link":"https://goo.gl/maps/CL5WbWoEM2Xox64QA","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"israel and the west bank","country_name":"Israel & the West Bank"},{"id":"B8PX","text":["In Ness Ziona, There is an **Israeli flag** on house numbers."],"text_zh":[],"image":"plonkit/israel-west-bank/il_nesszionahousenumber.webp","link":"https://goo.gl/maps/51TcLiNaqaY5ny3UA","clues":["house_numbers","flags","architecture"],"important":false,"tagged":false,"country":"israel and the west bank","country_name":"Israel & the West Bank"},{"id":"algU","text":["Blue, **shield-shaped house numbers** are unique to the city of Herzliya."],"text_zh":[],"image":"plonkit/israel-west-bank/il_herzliyahousenumber.webp","link":"https://www.google.com/maps/@32.1636082,34.8452915,3a,15y,274.43h,90.35t/data=!3m6!1e1!3m4!1sKCqd6MMHcmRKgiNpkFcDuQ!2e0!7i13312!8i6656?entry=ttu","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"israel and the west bank","country_name":"Israel & the West Bank"},{"id":"94iJ","text":["Latvian house numbers are often shaped like **tall rectangles** and can be found in [several colours](https://www.google.com/maps/@56.6568307,23.7457261,3a,15y,38.74h,91.25t/data=!3m6!1e1!3m4!1sP7bXCAylAr5ghFSDKp9l1g!2e0!7i16384!8i8192?entry=ttu).","NOTE: This is not common in Estonia or Lithuania."],"text_zh":[],"image":"plonkit/latvia/lv_housenumber.webp","link":"https://www.google.com/maps/@57.177445,26.7603386,3a,15y,165.76h,88.86t/data=!3m6!1e1!3m4!1smlkqmcNiQQjg3uWHytAaYg!2e0!7i16384!8i8192?entry=ttu","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"latvia","country_name":"Latvia"},{"id":"1BOY","text":["House numbers in Slovakia are typically written on **white signs **with a thin red or black border."],"text_zh":[],"image":"plonkit/slovakia/sk_housenumbers.webp","link":"https://goo.gl/maps/MUxaTwKw8Be7i7ZG9","clues":["house_numbers","architecture","signs"],"important":false,"tagged":false,"country":"slovakia","country_name":"Slovakia"},{"id":"9zaA","text":["Slovenian house numbers are typically **red** with white text.","NOTE: [Czech](https://www.google.com/maps/@50.7257121,15.1788819,3a,15y,1.15h,98.69t/data=!3m6!1e1!3m4!1s4rpA0yUvp4TJif4QGtcHvQ!2e0!7i16384!8i8192?entry=ttu) house numbers are also commonly red."],"text_zh":[],"image":"plonkit/slovenia/si_housenumber.webp","link":"https://goo.gl/maps/Lc4H9tgSMno264Vq8","clues":["house_numbers","architecture"],"important":false,"tagged":false,"country":"slovenia","country_name":"Slovenia"},{"id":"y26n","text":["Instead of the normal red house numbers, Ljubljana will typically feature **green house numbers**.","NOTE: [Street signs](https://goo.gl/maps/h5GSwk121qRJantj8) in Ljubljana are also occasionally green."],"text_zh":[],"image":"plonkit/slovenia/si_ljubljanahousenumber.webp","link":"https://goo.gl/maps/pTMPQMesA31QVMHC6","clues":["house_numbers","architecture","signs"],"important":false,"tagged":false,"country":"slovenia","country_name":"Slovenia"},{"id":"oOJ9","text":["Korean buildings have very distinctive **house numbers**. They are blue and usually are shaped quite literally like a house. The full address of the building is written on them, in both Hangul and Latin script.","Some places have unique house numbers, which you can use to region-guess. More information about this can be found in the spotlight section."],"text_zh":[],"image":"plonkit/south-korea/kr_house_number.webp","link":"https://goo.gl/maps/2GHGKRZix5fWNu586","clues":["house_numbers","architecture","language"],"important":false,"tagged":false,"country":"south korea","country_name":"South Korea"},{"id":"zUjA","text":["House numbers in the Hampyeong region can be recognised from the **large white section** at the top of the sign."],"text_zh":[],"image":"plonkit/south-korea/kr_hampyeonghousenumber.webp","link":"https://goo.gl/maps/Fzkc7Sf4kW3UkNqo7","clues":["house_numbers","architecture","signs"],"important":false,"tagged":false,"country":"south korea","country_name":"South Korea"},{"id":"bl0n","text":["Red street signs with a coloured bottom strip are found in several cities. In the bottom right corner, you can find a white arrow and some numbers. If this arrow is pointing in **both directions** and has a **single arrowhead**, rather than [double](https://goo.gl/maps/Fd5tuzksA3NY8YsF7), then you are almost certainly in Istanbul.","Beware that simple arrows pointing in only one direction can be found in both [Istanbul](https://goo.gl/maps/6uFmLFqcEn2bT7vL9) and in [other cities](https://goo.gl/maps/BBU6aeQ2BoBN38YH8). However, if you see such signs in combination with [red house numbers](https://goo.gl/maps/kjNkwByQZ7rNaQXdA), then you should be in Istanbul."],"text_zh":[],"image":"plonkit/turkey/tr_streetsignistanbul.webp","link":"https://goo.gl/maps/zTReodSx4dEU2Hhz5","clues":["house_numbers","architecture","signs"],"important":false,"tagged":false,"country":"turkey","country_name":"Turkey"},{"id":"xnIM","text":["Street signs in Trabzon and [Yalvaç](https://goo.gl/maps/vZmpbacvJeyzbMWc9) are **red** and **oval-shaped**. [House numbers](https://goo.gl/maps/96X34Wg24K87jPG4A) also feature the same design."],"text_zh":[],"image":"plonkit/turkey/tr_streetsigntrabzon.webp","link":"https://goo.gl/maps/r3tSKDy4QtLFoBqq9","clues":["house_numbers","architecture","signs"],"important":false,"tagged":false,"country":"turkey","country_name":"Turkey"},{"id":"U1Mv","text":["A horizontal blue, red, or green sign can commonly be seen at the ends of driveways in Wisconsin and the Michigan peninsula. The house number is present, in addition to either the **town name** and or the **road name** (usually).","NOTE: Nearby states often use [similar markers](https://goo.gl/maps/ETNAA9cvLDbB92Lw9), but typically lack any town or street name information and only feature numbers."],"text_zh":[],"image":"plonkit/united-states/25us_wisconsinmichiganpeninsulasign.webp","link":"https://goo.gl/maps/tcEv3GSWnpnnDd9CA","clues":["house_numbers","architecture","signs"],"important":false,"tagged":false,"country":"united states of america","country_name":"United States of America"}],"gallery_count":32,"tip_count":21}